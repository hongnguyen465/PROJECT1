APP_NAME=order-service
APP_ENV=production
APP_DEBUG=false
APP_URL=https://YOUR-ORDER-SERVICE.onrender.com
APP_KEY=base64:YOUR_APP_KEY_HERE
TRUSTED_PROXIES=*
LOG_CHANNEL=stderr
LOG_LEVEL=info
PORT=10000

DB_CONNECTION=mysql
DB_HOST=YOUR-AIVEN-HOST
DB_PORT=YOUR-AIVEN-PORT
DB_DATABASE=football_order_db
DB_USERNAME=avnadmin
DB_PASSWORD=YOUR-AIVEN-PASSWORD
MYSQL_ATTR_SSL_CA=/etc/secrets/ca.pem

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=sync

RUN_MIGRATIONS=true
RUN_SEEDERS=false

CATALOG_SERVICE_URL=https://YOUR-CATALOG-SERVICE.onrender.com
PAYMENT_SERVICE_URL=https://YOUR-PAYMENT-SERVICE.onrender.com
INTERNAL_SERVICE_SECRET=STRIKER_SECRET_TOKEN_2026

GHN_TOKEN=e4b7b3be-fb27-11ee-8bfa-8a2dda8ec551
GHN_SHOP_ID=5015949
GHN_CLIENT_ID=5015949
